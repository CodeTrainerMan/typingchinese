# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

/web/logs
# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 运营内容统一放 ../ref/（根 .gitignore 的 /ref/ 已排除，不进 GitHub）。
# 项目自身的造词库/汉字数据脚本不在此列，仍需提交。
/logs/
/_tmp_*
/scripts/_disabled/
/scripts/cp-*.mjs
/scripts/cf-*.mjs
/scripts/gsc-*.mjs
/scripts/hn-*.mjs
/scripts/ph-*.mjs
/scripts/browser.mjs
/scripts/login-setup.mjs
/scripts/check-login.mjs
/scripts/stealth-check.mjs
/scripts/demo-capture.mjs

.vercel
.env*
