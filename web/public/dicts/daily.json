{"id":"daily","name":"日常常用词","description":"最常用的双音节词，适合入门与日常提速","category":"基础","tags":["常用","入门"],"level":1,"length":59,"words":[{"id":"daily-0","word":"中国","pinyin":["zhōng","guó"],"flat":"zhongguo","flatSpaced":"zhong guo","toneNum":"zhong1 guo2","initials":"zg","syllables":["zhong","guo"],"trans":"China","length":2,"examples":[{"zh":"我来自中国。","en":"I am from China."},{"zh":"中国很大。","en":"China is very big."},{"zh":"他在中国工作。","en":"He works in China."}],"example":"我来自中国。","exampleTrans":"I am from China."},{"id":"daily-1","word":"人民","pinyin":["rén","mín"],"flat":"renmin","flatSpaced":"ren min","toneNum":"ren2 min2","initials":"rm","syllables":["ren","min"],"trans":"people","length":2,"examples":[{"zh":"中国人民很友好。","en":"The Chinese people are friendly."},{"zh":"为人民服务。","en":"Serve the people."},{"zh":"人民公园很漂亮。","en":"People's Park is beautiful."}],"example":"中国人民很友好。","exampleTrans":"The Chinese people are friendly."},{"id":"daily-2","word":"时间","pinyin":["shí","jiān"],"flat":"shijian","flatSpaced":"shi jian","toneNum":"shi2 jian1","initials":"sj","syllables":["shi","jian"],"trans":"time","length":2,"examples":[{"zh":"时间很宝贵。","en":"Time is precious."},{"zh":"我没有时间。","en":"I have no time."},{"zh":"请准时，时间很重要。","en":"Please be on time; time matters."}],"example":"时间很宝贵。","exampleTrans":"Time is precious."},{"id":"daily-3","word":"学习","pinyin":["xué","xí"],"flat":"xuexi","flatSpaced":"xue xi","toneNum":"xue2 xi2","initials":"xx","syllables":["xue","xi"],"trans":"to study; to learn","length":2,"examples":[{"zh":"我在学习汉语。","en":"I am studying Chinese."},{"zh":"学习很重要。","en":"Learning is important."},{"zh":"他每天学习两小时。","en":"He studies two hours every day."}],"example":"我在学习汉语。","exampleTrans":"I am studying Chinese."},{"id":"daily-4","word":"工作","pinyin":["gōng","zuò"],"flat":"gongzuo","flatSpaced":"gong zuo","toneNum":"gong1 zuo4","initials":"gz","syllables":["gong","zuo"],"trans":"to work; a job","length":2,"examples":[{"zh":"我有一份好工作。","en":"I have a good job."},{"zh":"他工作很